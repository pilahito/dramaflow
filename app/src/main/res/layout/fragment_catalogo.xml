<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0B0F19">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="DramaFlow" android:textSize="30sp" android:textStyle="bold"
        android:textColor="#F2F7FF" android:padding="18dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Series cortas · catálogo libre (dominio público y CC)" android:textSize="12sp"
        android:textColor="#8E8E93" android:paddingHorizontal="18dp" android:paddingBottom="8dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingHorizontal="12dp" android:clipToPadding="false"/>
</LinearLayout>
