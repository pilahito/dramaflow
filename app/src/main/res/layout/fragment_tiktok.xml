<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0B0F19">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="TikTok · short drama" android:textSize="28sp" android:textStyle="bold"
        android:textColor="#F2F7FF" android:paddingHorizontal="18dp" android:paddingTop="18dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Vista web oficial de TikTok (no se descarga contenido)."
        android:textSize="12sp" android:textColor="#8E8E93"
        android:paddingHorizontal="18dp" android:paddingBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="14dp" android:paddingBottom="8dp">
        <Button android:id="@+id/btn_tiktok_app" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Abrir en TikTok"
            android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#8B5CF6"/>
        <Button android:id="@+id/btn_tiktok_navegador" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Navegador"
            android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#1B2438"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <WebView android:id="@+id/web_tiktok" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
